rules_version = '2';

// Sipariş dosyaları: orders/{uid}/{ref}/photos/*.jpg ve orders/{uid}/{ref}/*.json.
// Kullanıcı yalnız kendi klasörüne, dosya başına 25 MB'a kadar JPEG/JSON yazar; silme yalnız matbaada.
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{uid}/{ref}/{path=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'application/json'];
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
